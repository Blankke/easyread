{
  "name": "easyread-desktop",
  "version": "1.4.4",
  "description": "EasyRead desktop application powered by Electron",
  "author": "Edwardxlai",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev_desktop.cjs",
    "start": "node scripts/dev_desktop.cjs",
    "test:web": "node --test tests/desktop/test_chatgpt*.cjs tests/web/test_web_browser_nav.cjs tests/web/test_chat_ui.cjs tests/web/test_web_translation_settings.cjs",
    "build:backend": "python scripts/build_backend.py",
    "dist": "npm run build:backend && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "publish": [{ "provider": "github", "owner": "Edwardxlai", "repo": "easyread" }],
    "appId": "com.edwardxlai.easyread",
    "productName": "EasyRead",
    "protocols": [{ "name": "EasyRead", "schemes": ["easyread"] }],
    "asar": true,
    "directories": {
      "output": "dist/electron"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "icon": "electron/assets",
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "installer/installer.nsh",
      "createDesktopShortcut": true,
      "artifactName": "EasyRead-Setup-${version}.exe"
    },
    "mac": {
      "icon": "electron/assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "publications",
      "identity": null,
      "hardenedRuntime": false
    },
    "afterSign": "scripts/mac_sign.cjs",
    "linux": {
      "icon": "electron/assets/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
